# Discord Bot Configuration
# Get your bot token from: https://discord.com/developers/applications
# Required Discord Intents: Presence Intent, Server Members Intent, Message Content Intent

# MongoDB Configuration
# For Docker: Use mongodb://mongodb:27017/owobot (automatically configured in docker-compose)
# For local development: Use mongodb://localhost:27017/owobot
# For MongoDB Atlas: Use your Atlas connection string
MONGODB_URI=mongodb://localhost:27017/owobot

# Environment (optional, defaults handled by docker-compose)
NODE_ENV=development
